# Default
TZ=America/Sao_Paulo

PROJECT_NAME="Fiocruz Variant Browser API"
VERSION="1.0.0"
API_V1_STR=""

# Security - CORS
#BACKEND_CORS_ORIGINS=["*"]
BACKEND_CORS_ORIGINS=["https://aprovardb.icc.fiocruz.br/"]

# Security - Autenticação
xpack.security.enabled=true

# Senha superadmin 'elastic' user
ELASTICSEARCH_USER="elastic"
ELASTIC_PASSWORD=SENHA_TROCAR

# Configurações Elastic
# Production
# ES_JAVA_OPTS=-Xms20g -Xmx20g

# Dev
ES_JAVA_OPTS=-Xms2g -Xmx2g
bootstrap.memory_lock=true
discovery.type=single-node

# Certificado autoassinado (TLS/HTTPS)                                                                                                                                                                        
xpack.security.http.ssl.enabled=true                                                                                                                                                                          
xpack.security.http.ssl.key=/usr/share/elasticsearch/config/certs/elastic.key                                                                                                                                 
xpack.security.http.ssl.certificate=/usr/share/elasticsearch/config/certs/elastic.crt 
